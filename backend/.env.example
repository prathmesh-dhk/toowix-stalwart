PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/toowix_mail
STALWART_URL=http://localhost:8090
STALWART_USER=toowix-service@toowix.test
STALWART_PASSWORD=ToowixServiceSecret2026!Secure
STALWART_ACCOUNT_ID=b
JWT_SECRET=toowix_super_secret_jwt_key_32_bytes_min_2026!
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
TENANT_ADMIN_URL=http://localhost:5174

# Encrypts tenant-supplied DNS provider credentials at rest (AES-256-GCM) —
# GoDaddy, Hostinger, and Cloudflare all share this one key (the field name
# is a holdover from when GoDaddy was the only provider).
# Generate with: openssl rand -base64 32
# Do NOT reuse BACKUP_ENCRYPTION_KEY or JWT_SECRET for this.
GODADDY_CREDENTIAL_ENCRYPTION_KEY=

# Optional base URL overrides for each DNS provider's API — only needed to
# point at a sandbox/test environment. Leave unset to use each provider's
# real production API.
#
# GoDaddy defaults to https://api.godaddy.com. Set to
# https://api.ote-godaddy.com to test against GoDaddy's OTE sandbox with a
# key generated for that environment (GoDaddy keys are environment-specific
# — an OTE key will be rejected as invalid by the production endpoint and
# vice versa).
GODADDY_API_BASE_URL=

# Hostinger defaults to https://developers.hostinger.com — no separate
# sandbox is documented, so this is mainly useful for pointing at a mock
# server in tests.
HOSTINGER_API_BASE_URL=

# Cloudflare defaults to https://api.cloudflare.com/client/v4 — no separate
# sandbox is documented either.
CLOUDFLARE_API_BASE_URL=
