# ==============================================================================
# Toowix Mail Platform — Production Environment Variables Template
# ==============================================================================

# --- Application Ports ---
PORT_ADMIN_HTTP=5173
PORT_HTTP=5174
PORT_WEBMAIL=8888

# Public URL the browser uses to reach Bulwark webmail itself — must be
# same-origin from the browser's perspective (never Stalwart's internal
# Docker hostname). See deploy/docker-compose.prod.yml's webmail service.
WEBMAIL_PUBLIC_URL=https://webmail.toowix.com

# --- MongoDB 7.0 Database ---
MONGODB_URI=mongodb://mongodb:27017/toowix_mail

# --- Authentication & JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_cryptographically_secure_jwt_secret_key_here

# --- AES-256 Backup Encryption Key ---
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=replace_with_strong_backup_encryption_secret_key_32b_here

# --- AES-256 GoDaddy DNS Credential Encryption Key ---
# Encrypts tenant-supplied GoDaddy API key/secret pairs at rest during domain activation.
# Generate with: openssl rand -base64 32
# Must NOT be the same value as BACKUP_ENCRYPTION_KEY or JWT_SECRET.
GODADDY_CREDENTIAL_ENCRYPTION_KEY=replace_with_strong_godaddy_credential_encryption_key_32b_here

# --- S3 / Cloudflare R2 Remote Backup Storage (Optional) ---
AWS_S3_BUCKET=toowix-mail-backups
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_REGION=us-east-1

# --- Outage & Incident Alerting (Slack / Discord Webhooks) ---
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/WEBHOOK
ALERT_EMAIL=ops@toowix.com

# --- Stalwart Service Account Configuration ---
# Dedicated Toowix control plane account with Management API rights
STALWART_URL=http://stalwart:8080
STALWART_SERVICE_USER=toowix-service@toowix.test
STALWART_SERVICE_PASSWORD=replace_with_strong_stalwart_service_account_password_here
STALWART_ACCOUNT_ID=b
# Optional: ACME provider ID for TLS certificate management (auto-detected if omitted)
# STALWART_ACME_PROVIDER_ID=

# --- Initial Super Admin Account ---
INITIAL_ADMIN_EMAIL=admin@toowix.com
INITIAL_ADMIN_PASSWORD=replace_with_strong_platform_admin_initial_password_here

# --- Outbound SMTP (transactional email: activation links, OTPs, alerts) ---
# No fallback defaults are provided in docker-compose.prod.yml for these —
# the backend container will start with SMTP disabled/broken if unset, which
# is intentional so a real credential never sits in the compose file itself.
SMTP_HOST=email.toowix.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER_EMAIL=replace_with_smtp_account_email
SMTP_USERNAME=replace_with_smtp_account_username
SMTP_PASS=replace_with_smtp_account_password
SMTP_FROM="Toowix Mail Platform" <noreply@toowix.com>
SMTP_ENABLE=true